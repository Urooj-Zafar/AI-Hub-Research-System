# Groq credential (add the real value with Replit Secrets)
GROQ_API_KEY=your_groq_api_key_here

# Replit's managed PostgreSQL injects DATABASE_URL automatically.
# For a separate PostgreSQL database, set all of these instead.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=urooj1234
DB_NAME=ai-hub

# The fixed model for baseline runs, task models, and fallback model are
# configured centrally in app/core/config.py. Set these to override them.
GROQ_BASELINE_MODEL=openai/gpt-oss-20b
GROQ_MODEL_CODING=qwen/qwen3.8-27b
GROQ_MODEL_GENERAL=openai/gpt-oss-20b
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_MODEL_CREATIVE=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

GROQ_TIMEOUT_SECONDS=20
MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Controlled test failures are off by default. Simulated records are flagged
# and excluded from real experiment metrics.
SIMULATE_FAILURE=false
FAILURE_RATE=0
